# Copy this file to .env and fill in your Supabase database password.
# Use the connection string from Supabase Dashboard > Project Settings > Database.

# Recommended: one full Supabase Postgres URL.
DATABASE_URL=postgresql://postgres.your-project-ref:your-password@aws-0-your-region.pooler.supabase.com:6543/postgres

# Alternative: use separate values instead of DATABASE_URL.
# SUPABASE_DB_HOST=db.your-project-ref.supabase.co
# SUPABASE_DB_PORT=5432
# SUPABASE_DB_NAME=postgres
# SUPABASE_DB_USER=postgres
# SUPABASE_DB_PASSWORD=your-password
# SUPABASE_DB_SSLMODE=require
